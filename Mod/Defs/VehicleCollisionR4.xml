<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Structural deformation from a confirmed mesh contact, not a projectile.
       Keep the VF component/reactor/event/death pipeline; ballistic armour
       cannot convert a real crash into a zero-damage ricochet. -->
  <DamageDef Name="FPS_StructuralDamage" Abstract="True">
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <hediff>Crush</hediff>
    <hediffSkin>Cut</hediffSkin>
    <hediffSolid>Crack</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Blunt</impactSoundType>
    <overkillPctToDestroyPart>0.4~1.0</overkillPctToDestroyPart>
  </DamageDef>
  <DamageDef ParentName="FPS_StructuralDamage">
    <defName>FPS_VehicleCollisionR4</defName>
    <label>vehicle collision</label>
    <deathMessage>{0} was crushed in a vehicle collision.</deathMessage>
  </DamageDef>
  <DamageDef ParentName="FPS_StructuralDamage">
    <defName>FPS_AirblastStress</defName>
    <label>airblast structural stress</label>
    <deathMessage>{0} was killed by airblast structural damage.</deathMessage>
  </DamageDef>
</Defs>
